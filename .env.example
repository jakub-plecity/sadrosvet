# Enter the real values only in Netlify > Project configuration > Environment variables.
# Never commit credentials. No NEXT_PUBLIC_ prefix: these are server-side settings.
LOCAL_ADMIN_USERNAME=sadrosvetadmin
LOCAL_ADMIN_PASSWORD=
# Generate a fresh random secret, at least 32 bytes: openssl rand -hex 32
ADMIN_SESSION_SECRET=
RESEND_API_KEY=
ORDER_EMAIL_FROM=SádroSvět <objednavky@sadrosvet.cz>
ORDER_EMAIL_REPLY_TO=sadrosvet@seznam.cz
# Public 16-character Packeta widget API key; not the private API password.
PACKETA_API_KEY=
# Set after the Netlify URL is assigned. Later change to https://sadrosvet.cz.
SITE_ORIGIN=
# Netlify Database and Blobs credentials are managed by Netlify automatically.

# Explicit cutover only after the source data has been copied and verified.
DATABASE_PROVIDER=netlify
SUPABASE_DATABASE_URL=
# Optional PEM root certificate from Supabase if required for TLS verification.
SUPABASE_DATABASE_CA=

# Google Search Console property: sc-domain:sadrosvet.cz or verified URL-prefix property.
GSC_SITE_URL=sc-domain:sadrosvet.cz
# Grant the service-account address read access to this Search Console property.
GSC_SERVICE_ACCOUNT_EMAIL=
# PEM private key, with literal \\n allowed for line breaks; secret must stay server-side.
GSC_PRIVATE_KEY=
